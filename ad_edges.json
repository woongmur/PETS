      "summary": "빈 비밀번호로 인증 시도 가치 있음.",
      "cmd": ["nxc smb dc01 -u TARGETUSER -p ''"],
      "tools": [{"name": "NetExec", "type": "py", "url": "https://github.com/Pennyw0rth/NetExec"}]
    },
    "SIDHistory": {
      "ko": "SID History 보유 (과거 특권 SID 상속 가능)",
      "priority": "med",
      "summary": "SID History 에 특권 그룹 SID 가 있으면 그 권한을 그대로 상속.",
      "cmd": ["# BloodHound 에서 SIDHistory 대상 그룹 확인 후 접근 경로 평가"],
